<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Red -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Reproducción en segundo plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Descubrimiento de dispositivos Google Cast -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Tiempo en la ubicación actual (Inicio). Solo aproximada: de sobra
         para el tiempo, no hace falta la precisión de ACCESS_FINE_LOCATION
         (ni el permiso extra que eso implicaría pedir). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Actualizar la app dentro de sí misma (fuera de Play Store, Android
         sigue exigiendo que el usuario confirme la instalación). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".RadioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiRadio"
        tools:targetApi="34">

        <!-- Google Cast necesita conocer el id de aplicación receptora y las opciones -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.miradio.app.playback.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MiRadio"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Enlace directo usado por el acceso directo de App Actions
                 (Ok Google, "abre reproducir en Mi Radio") para arrancar la
                 radio sin pasar por la interfaz. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="miradio" android:host="play" />
            </intent-filter>

            <!-- Declara la App Action "OPEN_APP_FEATURE" (ver res/xml/shortcuts.xml)
                 para que Google Assistant pueda ofrecer "Ok Google, reproduce en
                 Mi Radio". Funciona probando con la app de pruebas de App Actions
                 de Google incluso sin publicar en Play Store, aunque el reconocimiento
                 por voz es más fiable una vez publicada. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Servicio en primer plano: MediaSession + ExoPlayer, controla la reproducción
             aunque la app pase a segundo plano o la pantalla se bloquee. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Widget de pantalla de inicio -->
        <receiver
            android:name=".widget.RadioWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/app_widget_info" />
        </receiver>

        <!-- Permite pasarle al instalador del sistema el APK descargado a
             almacenamiento privado de la app (Android 7+ exige content://). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
